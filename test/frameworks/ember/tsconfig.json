{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "ember-source/types",
      "@glint/ember-tsc/types",
      "@embroider/core/virtual",
      "vite/client",
      "unplugin-icons/types/ember",
      "unplugin-icons/types/raw-prefix"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "app/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "package",
    "dist"
  ]
}
